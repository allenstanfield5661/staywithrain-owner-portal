# mock is the local and static preview. live reads Hostaway on the server.
DATA_MODE=mock

# Required when DATA_MODE=live. Generate the hash with scripts/hash-password.mjs.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# JSON: {"owners":[{"id":"owner-placeholder","name":"Placeholder Owner","email":"owner@example.com","listingIds":["REPLACE_WITH_HOSTAWAY_LISTING_ID"]}]}
# OWNERS_JSON=

# Any long random string. Required for live mode.
SESSION_SECRET=replace-with-a-long-random-string

# Set COOKIE_SECURE=true only when the portal is served over HTTPS.
# Vercel sets this itself. Leave it unset for local http.
# COOKIE_SECURE=false

# Hosted previews refuse to open until this is set. Leave it unset for npm run dev.
# PREVIEW_PASSWORD=

# Hostaway. Use a ready-made bearer token, or the account id plus API key.
# The key is exchanged for a token at https://api.hostaway.com/v1/accessTokens.
# HOSTAWAY_TOKEN=
# HOSTAWAY_ACCOUNT_ID=
# HOSTAWAY_API_KEY=

# Google Calendar → each golf cart calendar → Settings and sharing →
# Integrate calendar → Secret address in iCal format.
# Comma-separate STR Golf Cart Rentals and Subedi Realty Golf Cart.
# Treat these URLs like passwords. Do not commit them.
# GOLF_CART_ICS_URLS=
# GOLF_CART_ICS_URL=
